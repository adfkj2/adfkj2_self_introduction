---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MemoryAtlas from '../components/MemoryAtlas.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingEmpty from '../components/WritingEmpty.astro';
import PostList from '../components/PostList.astro';
import { projects } from '../data/projects';
import { profile, topics } from '../data/site';
import { getPublishedPosts } from '../utils/posts';
const posts = (await getPublishedPosts()).slice(0, 4);
const focusLinks = [
  { href: '/projects/tickets/', label: 'Java 工单系统' },
  { href: '/projects/dive/', label: 'D.I.V.E.' },
  { href: '/projects/medical/', label: 'Medical QA' },
  { href: '/projects/', label: '工程实践' },
];
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-2" aria-hidden="true"></div>
    <div class="hero-main">
      <div class="hero-copy">
        <p class="hero-identity">
          <span class="identity-line"></span>
          <span translate="no">{profile.name || profile.handle}</span>
          <span class="hero-handle" translate="no">
            / {profile.handle}
          </span>
        </p>
        <p class="hero-role">Java backend engineer & AI agent builder</p>
        <h1 id="hero-title">
          <span class="hero-line">构建可靠的系统。</span>
          <span class="hero-line">
            探索<span class="hero-shimmer">智能的边界</span>。
          </span>
        </h1>
        <p class="hero-description">
          用 Java 构建后端，用记忆与检索增强 Agent。
          <br />
          关注系统的正确性，也探索智能更可靠的使用方式。
        </p>
        <div class="hero-cta">
          <a class="button button-primary magnetic" href="/projects/">
            浏览项目
            <Icon name="arrow" size={18} />
          </a>
          <a class="hero-writing-link" href="/writing/">
            阅读笔记
            <Icon name="arrow" size={17} />
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <MemoryAtlas />
      </div>
    </div>
    <div class="tech-strip">
      <p>技术方向</p>
      <div class="marquee">
        <div class="marquee-track">
          <div class="marquee-group" translate="no">
            <span>Java</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>Spring Boot</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>MySQL</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>PostgreSQL</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>AI Agents</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>RAG</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>Long-term Memory</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>Vector Search</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>Linux</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
          </div>
          <div class="marquee-group" aria-hidden="true" translate="no">
            <span>Java</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>Spring Boot</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>MySQL</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>PostgreSQL</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>AI Agents</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>RAG</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>Long-term Memory</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>Vector Search</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
            <span>Linux</span>
            <i class="marquee-dot" aria-hidden="true">
              ✦
            </i>
          </div>
        </div>
      </div>
    </div>
    <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>
      暂停动效
    </button>
  </section>
  <section class="container section work-section" aria-labelledby="work-title">
    <div class="section-heading" data-reveal>
      <div>
        <h2 class="section-title" id="work-title">
          作品与实践
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        全部项目<span class="link-count">{projects.length}</span>
        <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
  <section class="container section focus-section" aria-labelledby="focus-title">
    <div class="focus-layout">
      <div class="focus-lead" data-reveal>
        <h2 class="section-title" id="focus-title">
          向下扎根，
          <br />
          向前探索。
        </h2>
        <p class="section-intro">
          从业务逻辑与数据存储，
          <br />
          到记忆、检索与智能体。
        </p>
      </div>
      <div class="focus-list">
        {topics.map((topic, i) => (
          <div class="focus-item" data-reveal data-reveal-delay={i * 90}>
            <div>
              <h3>{topic.label}</h3>
              <p>{topic.description}</p>
            </div>
            <a class="focus-project" href={focusLinks[i].href}>
              {focusLinks[i].label}
              <Icon name="arrow" size={16} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="container section writing-section" aria-labelledby="writing-title">
    <div class="section-heading" data-reveal>
      <div>
        <p class="section-kicker">Journal</p>
        <h2 class="section-title" id="writing-title">
          实践之外，留一些思考。
        </h2>
      </div>
      <a class="text-link" href="/writing/">
        浏览笔记
        <Icon name="arrow" size={18} />
      </a>
    </div>
    {posts.length ? (
      <div data-reveal>
        <PostList posts={posts} />
      </div>
    ) : (
      <div data-reveal>
        <WritingEmpty headingLevel={3} compact />
      </div>
    )}
  </section>
  <section class="container about-preview" aria-labelledby="about-title" data-reveal>
    <div class="about-signature" aria-hidden="true">
      a<span>/</span>
    </div>
    <div>
      <h2 id="about-title">你好，我是{profile.name || profile.handle}。</h2>
      <p>
        在{profile.university}学习{profile.major}
        。个人项目是我的练习场：把问题拆开，把想法实现，再用证据检查结论。希望留下的，是能运行、能理解，也经得起追问的系统。
      </p>
    </div>
    <a class="text-link" href="/about/">
      更多关于我
      <Icon name="arrow" size={18} />
    </a>
  </section>
</BaseLayout>
