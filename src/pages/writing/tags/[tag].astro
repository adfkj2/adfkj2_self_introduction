---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WritingEmpty from '../../../components/WritingEmpty.astro';
import PostList from '../../../components/PostList.astro';
import { getPublishedPosts } from '../../../utils/posts';
import { topics, profile } from '../../../data/site';
export function getStaticPaths() {
  return topics.map((topic) => ({ params: { tag: topic.slug }, props: { topic } }));
}
const { topic } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) =>
  post.data.tags.some((tag) => tag === topic.slug),
);
---

<BaseLayout title={`${topic.label} — Writing — ${profile.handle}`} description={topic.description}>
  <div class="container">
    <header class="page-hero">
      <div class="eyebrow">JOURNAL / TOPIC</div>
      <h1>
        {topic.label}
        <span class="accent">.</span>
      </h1>
      <p>{topic.description}</p>
    </header>
    <div class="page-bottom">
      <nav class="filter-row" aria-label="按主题浏览">
        <a class="filter-button" href="/writing/">
          全部文章
        </a>
        {topics.map((t) => (
          <a
            class="filter-button"
            href={`/writing/tags/${t.slug}/`}
            aria-current={t.slug === topic.slug ? 'page' : undefined}
          >
            {t.label}
          </a>
        ))}
      </nav>
      <p class="page-caption">{posts.length} 篇正式文章</p>
      {posts.length ? <PostList posts={posts} /> : <WritingEmpty topic={topic.label} />}
    </div>
  </div>
</BaseLayout>
