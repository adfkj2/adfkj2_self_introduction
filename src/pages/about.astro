---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/site';
---

<BaseLayout
  title={`About — ${profile.handle}`}
  description="四川大学计算机科学与技术。关注 Java 后端、AI Agent 与长期记忆系统，以可核验的工程实践持续学习。"
>
  <div class="container">
    <header class="page-hero">
      <h1>
        保持好奇，
        <br />
        也保持严谨。
      </h1>
      <p>
        代码是理解世界的一种方式。
        <br />
        而把事情做扎实，是我希望一直保留的习惯。
      </p>
    </header>
    <div class="about-grid page-bottom">
      <div class="about-intro">
        <h2>
          你好，我是 {profile.name || profile.handle}
          <span class="accent">。</span>
          <br />
          在确定性与可能性之间，认真构建。
        </h2>
        <p>
          我在{profile.university}学习{profile.major}。目前的技术方向是 Java 后端与 AI
          Agent：一端是业务规则、数据与接口的确定性，另一端是记忆、检索与生成带来的新可能。
        </p>
        <p>
          我喜欢沿着一个真实问题向下追问：数据怎样保持一致？记忆什么时候应该更新？模型没有足够证据时，系统应该怎样回应？个人项目是把这些问题变成可运行实现、再反过来检验想法的地方。
        </p>
        <p>
          这个网站用来记录持续进行的工程实践，也用于展示实习与校招相关的个人项目。项目介绍尽量保留设计取舍、验证条件和没有解决的问题。
        </p>
        <div class="principles">
          <div class="eyebrow">A FEW THINGS I BELIEVE IN</div>
          {[
            {
              title: '先理解问题，再增加复杂度。',
              text: '清晰的业务边界和简单可维护的实现，是技术选型的起点。工具应该回应问题。',
            },
            {
              title: '让结论有证据，让失败可复现。',
              text: '测试条件、原始记录与失败边界，比孤立的性能数字更有意义。',
            },
            {
              title: '保持好奇，也尊重边界。',
              text: '对 AI 的可能性保持开放，同时认真对待可靠性、隐私和系统实际能做到的事。',
            },
          ].map((p, i) => (
            <div class="principle">
              <span>0{i + 1}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </div>
          ))}
        </div>
        <section class="resume-panel" id="resume">
          <Icon name="file" size={32} />
          <div>
            <h3>Resume / 简历</h3>
            {profile.resume ? (
              <a class="text-link" href={profile.resume} target="_blank" rel="noopener noreferrer">
                查看简历 PDF
                <Icon name="external" size={15} />
              </a>
            ) : (
              <>
                <p>简历 PDF 尚未公开。欢迎先查看项目的源码、架构与工程记录。</p>
                <span class="resume-label">NOT PUBLISHED YET</span>
                <br />
                <a class="text-link" href="/projects/">
                  查看项目经历
                  <Icon name="arrow" size={16} />
                </a>
              </>
            )}
          </div>
        </section>
      </div>
      <aside class="profile-panel">
        <div class="about-monogram" aria-hidden="true">
          a/
        </div>
        <h2>{profile.name || profile.handle}</h2>
        <p class="role">
          Java Backend Engineer
          <br />& AI Agent Builder
        </p>
        <ul class="profile-data">
          <li>
            <span>Education</span>
            {profile.university}
          </li>
          <li>
            <span>Major</span>
            {profile.major}
          </li>
          <li>
            <span>Focus</span>Backend + AI Agent
          </li>
          {profile.email && (
            <li>
              <span>Email</span>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
            </li>
          )}
          {profile.phone && (
            <li>
              <span>Phone</span>
              <a href={`tel:${profile.phone}`}>{profile.phone}</a>
            </li>
          )}
          <li>
            <span>GitHub</span>
            <a class="accent" href={profile.github} target="_blank" rel="noopener noreferrer">
              @{profile.handle}
              <Icon name="external" size={13} />
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>
