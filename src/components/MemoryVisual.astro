---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const layers = [0, 1, 2];
const nodes = [
  [260, 80],
  [150, 142],
  [260, 205],
  [370, 142],
  [205, 111],
  [315, 111],
  [205, 174],
  [315, 174],
  [260, 142],
];
---

<div class:list={['memory-visual', { compact }]}>
  <svg
    viewBox="0 0 520 430"
    fill="none"
    role="img"
    aria-label="长期记忆系统概念图：从交互形成记忆，经语义检索进入智能体上下文。"
  >
    <defs>
      <linearGradient
        id={compact ? 'mem-compact' : 'mem-hero'}
        x1="150"
        y1="80"
        x2="380"
        y2="390"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#8eb7fd" stop-opacity=".2" />
        <stop offset="1" stop-color="#4d77b9" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g class="memory-grid" stroke="currentColor" opacity=".07">
      <path d="m40 260 240-140 240 140-240 140Z" />
      <path d="m80 283 240-140m-200 163 240-140m-200 163 240-140m-200 163 240-140M80 237l240 140M120 214l240 140M160 191l240 140M200 168l240 140" />
    </g>
    <g stroke="#6b92cf" stroke-dasharray="3 6" opacity=".25">
      <path d="M260 80v250M150 142v170M370 142v170M205 111v170M315 111v170" />
    </g>
    {layers.map((layer) => (
      <g transform={`translate(0 ${layer * 69})`} class={`memory-layer layer-${layer}`}>
        <path
          d="m260 80 149 85-149 86-149-86Z"
          fill={`url(#${compact ? 'mem-compact' : 'mem-hero'})`}
          stroke="#597eaf"
          stroke-opacity={layer === 0 ? '.65' : '.35'}
        />
        <path d="m260 92 126 73-126 73-126-73Z" stroke="#6b92cf" stroke-opacity=".18" />
        <path
          d="m150 142 220 0m-165-31 110 63m0-63-110 63m55-94v125m-110-63 110 63 110-63-110-62Z"
          stroke="#6f99d7"
          stroke-opacity=".3"
        />
        {nodes.map(([x, y], i) => (
          <g>
            <circle
              cx={x}
              cy={y}
              r={i === 8 ? 8 : 4}
              fill={i === 8 ? '#719ee3' : '#1b2c44'}
              stroke="#8eb8fa"
              stroke-opacity=".7"
            />
            <circle cx={x} cy={y} r={i === 8 ? 2.4 : 1.3} fill="#b4cfff" />
          </g>
        ))}
      </g>
    ))}
    <g class="memory-labels" font-family="Consolas,monospace" font-size="9" letter-spacing=".5">
      <path d="M315 111h80l24-24" stroke="#557398" stroke-width=".7" />
      <text x="386" y="74" fill="#a0b1c9">
        01 / FORMATION
      </text>
      <path d="m370 211 45 0 17-17" stroke="#557398" stroke-width=".7" />
      <text x="389" y="184" fill="#8e9eb8">
        02 / RETRIEVAL
      </text>
      <path d="m150 280-52 0-20 20" stroke="#557398" stroke-width=".7" />
      <text x="22" y="317" fill="#8e9eb8">
        03 / CONTEXT
      </text>
    </g>
    <g class="memory-pulse">
      <circle cx="260" cy="222" r="13" stroke="#a6c5ff" opacity=".4" />
      <circle cx="260" cy="222" r="22" stroke="#a6c5ff" opacity=".1" />
    </g>
  </svg>
  {!compact && (
    <>
      <div class="visual-top">
        <span class="cross">+</span> MEMORY AS INFRASTRUCTURE <span class="cross">+</span>
      </div>
      <div class="visual-bottom">
        <span>
          <i></i> PERSIST. RETRIEVE. EVOLVE.
        </span>
        <span>FIG. 001</span>
      </div>
      <span class="visual-note">CONCEPTUAL SYSTEM MODEL</span>
    </>
  )}
</div>
<style>
  .memory-visual {
    position: relative;
    width: 100%;
    color: var(--accent);
    user-select: none;
  }
  .memory-visual > svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .visual-top,
  .visual-bottom {
    position: absolute;
    left: 8%;
    right: 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    color: var(--faint);
    font-size: 8px;
    letter-spacing: 1px;
  }
  .visual-top {
    top: 1%;
  }
  .cross {
    color: var(--accent);
    font-size: 14px;
  }
  .visual-bottom {
    bottom: 1%;
    font-size: 7px;
    letter-spacing: 0.6px;
  }
  .visual-bottom > span:first-child {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .visual-bottom i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--mint);
  }
  .visual-note {
    position: absolute;
    bottom: 10%;
    left: 48%;
    font-family: var(--mono);
    font-size: 6px;
    letter-spacing: 1px;
    color: var(--faint);
    transform: rotate(-30deg);
    opacity: 0.6;
  }
  .memory-pulse {
    animation: pulse 4s ease-in-out infinite;
  }
  .compact {
    max-width: 420px;
    margin-top: -8px;
  }
  .compact .memory-labels {
    display: none;
  }
  .compact > svg {
    margin-block: -45px;
  }
  .layer-0 {
    filter: drop-shadow(0 0 10px #7d9ce612);
  }
  [data-theme='light'] .memory-labels text {
    fill: #3f5e8f;
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  @media (max-width: 768px) {
    .memory-visual:not(.compact) {
      margin-top: 10px;
    }
    .visual-top {
      top: 4%;
    }
    .visual-bottom {
      bottom: 4%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .memory-pulse {
      animation: none;
    }
  }
</style>
