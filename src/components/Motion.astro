---
/** Progressive motion: content is always visible before and without this script. */
---

<div class="noise-overlay" aria-hidden="true"></div>

<script>
  import { animate } from 'animejs';

  const root = document.documentElement;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const controls = document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]');
  const running = new Set<ReturnType<typeof animate>>();
  let paused = false;
  try {
    paused = localStorage.getItem('portfolio-motion-paused') === 'true';
  } catch {
    // Motion controls also work when storage is unavailable.
  }
  const motionEnabled = () => !paused && !reducedMotion.matches;
  const finishAnimations = () => {
    for (const animation of [...running]) animation.complete();
    document.querySelectorAll<HTMLElement>('.magnetic').forEach((button) => {
      button.style.removeProperty('transform');
    });
  };
  const updateMotion = () => {
    root.dataset.motionReady = 'true';
    root.dataset.motionPaused = String(paused || reducedMotion.matches);
    if (!motionEnabled()) finishAnimations();
    controls.forEach((button) => {
      button.hidden = reducedMotion.matches;
      button.setAttribute('aria-pressed', String(paused));
      button.textContent = paused ? '开启动效' : '暂停动效';
    });
  };
  controls.forEach((button) => {
    button.addEventListener('click', () => {
      paused = !paused;
      try {
        localStorage.setItem('portfolio-motion-paused', String(paused));
      } catch {
        // The preference remains active for this page.
      }
      updateMotion();
    });
  });
  reducedMotion.addEventListener('change', updateMotion);
  updateMotion();

  // Animate on entry without installing a hidden state that could strand content.
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          if (!motionEnabled()) continue;
          const element = entry.target as HTMLElement;
          const animation = animate(element, {
            opacity: [0.65, 1],
            translateY: [18, 0],
            duration: 650,
            delay: Math.min(Number(element.dataset.revealDelay) || 0, 240),
            ease: 'outCubic',
            onComplete: () => {
              running.delete(animation);
              animation.revert();
            },
          });
          running.add(animation);
        }
      },
      { threshold: 0.06 },
    );
    document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
  }

  if (finePointer.matches) {
    document
      .querySelectorAll<HTMLElement>('.case-dive, .journal-compact, .profile-panel')
      .forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          if (!motionEnabled()) return;
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
          card.style.setProperty('--my', `${event.clientY - rect.top}px`);
        });
      });

    document.querySelectorAll<HTMLElement>('.magnetic').forEach((button) => {
      let reset: ReturnType<typeof animate> | undefined;
      const cancelReset = () => {
        if (!reset) return;
        reset.revert();
        running.delete(reset);
        reset = undefined;
      };
      button.addEventListener('pointermove', (event) => {
        if (!motionEnabled()) return;
        cancelReset();
        const rect = button.getBoundingClientRect();
        const x = event.clientX - rect.left - rect.width / 2;
        const y = event.clientY - rect.top - rect.height / 2;
        button.style.transform = `translate(${x * 0.1}px, ${y * 0.14}px)`;
      });
      button.addEventListener('pointerleave', () => {
        cancelReset();
        if (!motionEnabled()) return;
        const animation = animate(button, {
          translateX: 0,
          translateY: 0,
          duration: 450,
          ease: 'outCubic',
          onComplete: () => {
            running.delete(animation);
            animation.revert();
            button.style.removeProperty('transform');
            reset = undefined;
          },
        });
        reset = animation;
        running.add(animation);
      });
      button.addEventListener('focus', () => {
        cancelReset();
        button.style.removeProperty('transform');
      });
    });
  }

  const updateVisibility = () => {
    root.dataset.motionSuspended = String(document.hidden);
    for (const animation of running) {
      if (document.hidden) animation.pause();
      else animation.resume();
    }
  };
  document.addEventListener('visibilitychange', updateVisibility);
  updateVisibility();
</script>
