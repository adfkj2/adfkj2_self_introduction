---
import type { ProjectShot } from '../data/projects';
interface Props {
  shots?: ProjectShot[];
  name: string;
}
const { shots = [], name } = Astro.props;
---

{shots.length > 0 && (
  <section class="project-shots" aria-label={`${name} 界面截图`}>
    {shots.map((shot) => (
      <figure class="project-shot">
        <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
        {shot.caption && <figcaption>{shot.caption}</figcaption>}
      </figure>
    ))}
    <p class="shots-note">
      截图取自本地运行实例，账号与工单数据均已替换为演示值；界面细节以对应版本源码为准。
    </p>
  </section>
)}

<style>
  .project-shots {
    display: grid;
    gap: 22px;
    margin-top: 34px;
  }
  .project-shot {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
  }
  .project-shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .project-shot figcaption {
    padding: 13px 16px;
    font-size: 12px;
    line-height: 1.8;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }
  .shots-note {
    font-size: 12px;
    line-height: 1.8;
    color: var(--faint);
  }
</style>
