---
import { type Post, postUrl, readingTime } from '../utils/posts';
import Icon from './Icon.astro';
import FormattedDate from './FormattedDate.astro';
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<div class="post-list">
  {posts.map((post) => (
    <article class="post-row">
      <div class="post-date">
        <FormattedDate date={post.data.pubDate} />
        <span>{post.data.category}</span>
      </div>
      <div class="post-copy">
        <h2>
          <a href={postUrl(post)}>{post.data.title}</a>
        </h2>
        <p>{post.data.description}</p>
        <span class="post-time">约 {readingTime(post.body)} 分钟阅读</span>
      </div>
      <a class="post-arrow" href={postUrl(post)} aria-label={`阅读 ${post.data.title}`}>
        <Icon name="arrow" size={22} />
      </a>
    </article>
  ))}
</div>
<style>
  .post-row {
    display: grid;
    grid-template-columns: 142px minmax(0, 1fr) 48px;
    align-items: start;
    gap: 32px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .post-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .post-date {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    padding-top: 10px;
    line-height: 1.8;
    font-variant-numeric: tabular-nums;
  }
  .post-date span {
    display: block;
    font-size: 11px;
    margin-top: 8px;
    overflow-wrap: anywhere;
  }
  .post-copy {
    min-width: 0;
  }
  .post-row h2 {
    font-size: 26px;
    line-height: 1.5;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .post-row h2 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .post-row h2 a:hover {
    color: var(--accent);
  }
  .post-row p {
    color: var(--muted);
    max-width: 68ch;
    font-size: 15px;
    margin-top: 12px;
    line-height: 1.9;
    text-wrap: pretty;
  }
  .post-time {
    color: var(--faint);
    font-size: 12px;
    display: block;
    margin-top: 16px;
  }
  .post-arrow {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    color: var(--faint);
  }
  .post-arrow:hover {
    color: var(--accent);
  }
  @media (max-width: 800px) {
    .post-row {
      grid-template-columns: 118px minmax(0, 1fr) 48px;
      gap: 24px;
    }
    .post-row h2 {
      font-size: 24px;
    }
  }
  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: minmax(0, 1fr) 48px;
      gap: 12px 14px;
      padding-block: 26px;
    }
    .post-date {
      grid-column: 1/-1;
      display: flex;
      flex-wrap: wrap;
      gap: 5px 18px;
      align-items: center;
      padding-top: 0;
    }
    .post-date span {
      margin: 0;
    }
    .post-row h2 {
      font-size: 22px;
    }
    .post-row p {
      font-size: 15px;
      margin-top: 10px;
    }
    .post-time {
      font-size: 11px;
    }
  }
</style>
