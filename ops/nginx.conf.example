# Example only. Review paths and complete ICP / HTTPS setup before use.
server {
    listen 80;
    listen [::]:80;
    server_name adfkj2.cloud;
    root /var/www/personal-site/current;
    index index.html;
    charset utf-8;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 1024;

    location / {
        try_files $uri $uri/ =404;
    }
    location /_astro/ {
        expires 1y;
        try_files $uri =404;
    }
    location ~ /\. {
        deny all;
    }
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
