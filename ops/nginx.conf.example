# Example only. Review paths and complete ICP / HTTPS setup before use.
server {
    listen 80;
    listen [::]:80;
    server_name adfkj2.cloud;
    root /var/www/personal-site/current;
    index index.html;
    charset utf-8;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 1024;

    # 可选：把旧的 /blog/ 直接 301 到 /writing/。站内 /blog/ 页面已声明 noindex，
    # 但这属于服务器配置，发布脚本不会自动下发，需要手动改配置后 nginx -t && reload。
    location = /blog/ {
        return 301 /writing/;
    }
    location / {
        try_files $uri $uri/ =404;
    }
    location /_astro/ {
        expires 1y;
        try_files $uri =404;
    }
    location ~ /\. {
        deny all;
    }
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
